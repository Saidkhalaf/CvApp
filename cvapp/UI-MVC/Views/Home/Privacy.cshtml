@{
    ViewData["Title"] = "Privacybeleid";
}

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-primary mb-3">
                <i class="bi bi-shield-lock me-2"></i>Privacybeleid
            </h1>
            <p class="lead text-muted">ACEN HR Document Applicatie</p>
            <p class="text-muted">Laatst bijgewerkt: @DateTime.Now.ToString("dd MMMM yyyy")</p>
        </div>
    </div>

    <!-- Introduction -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">Inleiding</h2>
                    <p class="mb-0">
                        Welkom bij het privacybeleid van de ACEN HR Document Applicatie. ACEN ("wij", "ons" of "onze")
                        respecteert uw privacy en is toegewijd aan de bescherming van uw persoonsgegevens. Dit privacybeleid
                        legt uit hoe wij omgaan met uw gegevens wanneer u gebruikmaakt van onze HR-documentconversietool.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Who We Are -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">1. Wie zijn wij</h2>
                    <p><strong>ACEN</strong></p>
                    <ul class="list-unstyled mb-0">
                        <li><i class="bi bi-geo-alt me-2 text-primary"></i>Veldkant 7, 2550 Kontich, België</li>
                        <li><i class="bi bi-envelope me-2 text-primary"></i>cindy.vandenhoecke@is4u.be</li>
                        <li><i class="bi bi-telephone me-2 text-primary"></i>0471 88 37 55</li>
                        <li><i class="bi bi-globe me-2 text-primary"></i>www.is4u.be</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Data We Collect -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">2. Welke gegevens verzamelen wij</h2>
                    <p>Onze applicatie verwerkt de volgende soorten gegevens:</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h5 class="card-title h6 fw-semibold text-primary">
                                        <i class="bi bi-person me-2"></i>Persoonlijke gegevens
                                    </h5>
                                    <ul class="list-unstyled mb-0 small">
                                        <li>• Naam en voornaam</li>
                                        <li>• Adresgegevens</li>
                                        <li>• E-mailadres</li>
                                        <li>• Telefoonnummer</li>
                                        <li>• Geboortedatum</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h5 class="card-title h6 fw-semibold text-primary">
                                        <i class="bi bi-briefcase me-2"></i>HR-gerelateerde gegevens
                                    </h5>
                                    <ul class="list-unstyled mb-0 small">
                                        <li>• Opleidingsgegevens</li>
                                        <li>• Werkervaring</li>
                                        <li>• Vaardigheden</li>
                                        <li>• Certificaten</li>
                                        <li>• Talenkennis</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- How We Use Data -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">3. Hoe gebruiken wij uw gegevens</h2>
                    <p>Wij verwerken uw gegevens uitsluitend voor de volgende doeleinden:</p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Conversie van documenten:</strong> Het omzetten van Markdown, TXT of HTML-bestanden naar PDF-formaat
                        </li>
                        <li class="list-group-item px-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Genereren van cv</strong> Het creëren van CV's
                        </li>
                        <li class="list-group-item px-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Toepassing van branding:</strong> Toevoegen van uw bedrijfslogo, kleuren en lettertypes aan documenten
                        </li>
                        <li class="list-group-item px-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Verbetering van de dienst:</strong> Analyseren van het gebruik om onze applicatie te optimaliseren
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Legal Basis -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">4. Rechtsgrond voor verwerking</h2>
                    <p>Wij verwerken uw persoonsgegevens op basis van:</p>
                    <div class="alert alert-info border-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Artikel 6 AVG (GDPR):</strong> De verwerking is noodzakelijk voor de uitvoering van de overeenkomst
                        waarbij u partij bent, of om op uw verzoek voorafgaand aan de sluiting van de overeenkomst maatregelen te nemen.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Retention -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">5. Bewaartermijn</h2>
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <p>Wij bewaren uw persoonsgegevens niet langer dan noodzakelijk:</p>
                            <ul class="mb-0">
                                <li><strong>Tijdens sessie:</strong> Gegevens worden tijdelijk verwerkt tijdens het maken van cv</li>
                                <li><strong>Na conversie:</strong> Geüploade bestanden worden automatisch verwijderd na PDF-generatie</li>
                            </ul>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="display-4 text-primary">
                                <i class="bi bi-clock-history"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Sharing -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">6. Delen van gegevens met derden</h2>
                    <p>Wij verkopen uw persoonsgegevens niet aan derden. Wij delen uw gegevens alleen met:</p>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                            <tr>
                                <th>Categorie</th>
                                <th>Doel</th>
                                <th>Garanties</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>Hosting en technische ondersteuning</td>
                                <td>Verwerkersovereenkomst conform AVG</td>
                            </tr>
                            <tr>
                                <td><strong>PDF-conversietools</strong></td>
                                <td>Genereren van PDF-documenten</td>
                                <td>Geen gegevensopslag bij derden</td>
                            </tr>
                            <tr>
                                <td><strong>Overheidsinstanties</strong></td>
                                <td>Wettelijke verplichtingen</td>
                                <td>Alleen indien wettelijk verplicht</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Your Rights -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">7. Uw rechten</h2>
                    <p>Conform de Algemene Verordening Gegevensbescherming (AVG) heeft u de volgende rechten:</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-eye text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht op inzage</h6>
                                    <p class="mb-0 small text-muted">U kunt uw gegevens altijd inzien</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-pencil-square text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht op rectificatie</h6>
                                    <p class="mb-0 small text-muted">Foutieve gegevens laten corrigeren</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-trash text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht op verwijdering</h6>
                                    <p class="mb-0 small text-muted">"Recht om vergeten te worden"</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-shield-x text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht op beperking</h6>
                                    <p class="mb-0 small text-muted">Verwerking beperken</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-arrow-left-right text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht op overdraagbaarheid</h6>
                                    <p class="mb-0 small text-muted">Gegevens in gestructureerd formaat</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-x-circle text-primary fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Recht van bezwaar</h6>
                                    <p class="mb-0 small text-muted">Bezwaar maken tegen verwerking</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <p>Om uw rechten uit te oefenen, kunt u contact opnemen met:</p>
                        <div class="card bg-light border-0">
                            <div class="card-body">
                                <p class="mb-1"><strong>ACEN - t.a.v. Cindy Van den Hoecke</strong></p>
                                <p class="mb-1">Veldkant 7, 2550 Kontich</p>
                                <p class="mb-0">E-mail: <a href="mailto:cindy.vandenhoecke@is4u.be">cindy.vandenhoecke@is4u.be</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">8. Beveiliging</h2>
                    <p>Wij nemen passende technische en organisatorische maatregelen om uw persoonsgegevens te beschermen:</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-0 bg-success bg-opacity-10 h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-lock-fill text-success display-6 d-block mb-2"></i>
                                    <h6 class="fw-semibold">HTTPS Encryptie</h6>
                                    <p class="small text-muted mb-0">Alle data wordt versleuteld verzonden</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-info bg-opacity-10 h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-shield-check text-info display-6 d-block mb-2"></i>
                                    <h6 class="fw-semibold">Toegangscontrole</h6>
                                    <p class="small text-muted mb-0">Beperkte toegang tot persoonsgegevens</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-warning bg-opacity-10 h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-database-check text-warning display-6 d-block mb-2"></i>
                                    <h6 class="fw-semibold">Geen Opslag</h6>
                                    <p class="small text-muted mb-0">Bestanden worden niet permanent opgeslagen</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cookies -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">9. Cookies</h2>
                    <p>Onze applicatie maakt gebruik van minimale cookies:</p>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                            <tr>
                                <th>Type Cookie</th>
                                <th>Doel</th>
                                <th>Bewaartermijn</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>Essentiële cookies</strong></td>
                                <td>Noodzakelijk voor de werking van de applicatie</td>
                                <td>Sessie</td>
                            </tr>
                            <tr>
                                <td><strong>Functionele cookies</strong></td>
                                <td>Onthouden van taalvoorkeur</td>
                                <td>1 jaar</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Changes to Policy -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">10. Wijzigingen van dit privacybeleid</h2>
                    <p>
                        Wij kunnen dit privacybeleid van tijd tot tijd wijzigen. De meest actuele versie wordt altijd op deze pagina gepubliceerd.
                        Wij raden u aan deze pagina regelmatig te raadplegen om op de hoogte te blijven van eventuele wijzigingen.
                    </p>
                    <div class="alert alert-warning border-0 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Belangrijk:</strong> Bij ingrijpende wijzigingen zullen wij u actief informeren via e-mail of een melding in de applicatie.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm border-primary border-2">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">11. Contactgegevens</h2>
                    <p>Heeft u vragen over dit privacybeleid of onze verwerking van persoonsgegevens?</p>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="h6 fw-semibold">ACEN</h5>
                            <address class="mb-0">
                                <i class="bi bi-geo-alt me-2"></i>Veldkant 7<br>
                                <span class="ms-4">2550 Kontich, België</span><br>
                                <i class="bi bi-envelope me-2 mt-2"></i><a href="mailto:cindy.vandenhoecke@is4u.be">cindy.vandenhoecke@is4u.be</a><br>
                                <i class="bi bi-telephone me-2"></i>0471 88 37 55<br>
                                <i class="bi bi-globe me-2"></i><a href="https://www.is4u.be" target="_blank" rel="noopener">www.is4u.be</a>
                            </address>
                        </div>
                        <div class="col-md-6">
                            <h5 class="h6 fw-semibold">Gegevensbeschermingsautoriteit</h5>
                            <p class="small mb-0">
                                Indien u van mening bent dat wij niet zorgvuldig omgaan met uw persoonsgegevens,
                                heeft u het recht een klacht in te dienen bij de Belgische Gegevensbeschermingsautoriteit:
                            </p>
                            <address class="small mb-0 mt-2">
                                Drukpersstraat 35<br>
                                1000 Brussel, België<br>
                                <a href="mailto:contact@apd-gba.be">contact@apd-gba.be</a>
                            </address>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Note -->
    <div class="row">
        <div class="col-12">
            <div class="text-center text-muted">
                <p class="mb-0">
                    <small>
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Dit privacybeleid is opgesteld conform de Algemene Verordening Gegevensbescherming (AVG/GDPR)
                        en de Belgische privacywetgeving.
                    </small>
                </p>
            </div>
        </div>
    </div>
</div>