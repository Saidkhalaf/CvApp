@using cvapp.BL.Domain.enums
@model CVAPP.UI.Web.MVC.Models.CreateCertificateViewModel

@{
    ViewData["Title"] = "Nieuw certificaat";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";

    var cancelUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Url.Action("Create", "CvCertificate")
        : Model.ReturnUrl;
}

<div class="container py-4">
    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom px-4 py-3">
            <span class="fw-semibold">Nieuw certificaat</span>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="IsEmbedded" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium">Naam</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="d-block text-danger small mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Type" class="form-label fw-medium">Type</label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<CertificateType>()" class="form-select">
                        <option value="">-- Selecteer type --</option>
                    </select>
                    <span asp-validation-for="Type" class="d-block text-danger small mt-1"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 pt-3 border-top">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1 rounded-pill">
                        Toevoegen</button>

                    <a href="@cancelUrl"
                       class="btn btn-outline-secondary btn-lg flex-grow-1 rounded-pill js-embedded-cancel">
                        Annuleren
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
