@using cvapp.BL.Domain.enums
@model CVAPP.UI.Web.MVC.Models.CreateCvEducationViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Nieuwe opleiding";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";
    var targetFrame = "_self";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var nestedReturnUrl = Url.Action("Create", "CvEducation", new
    {
        returnUrl = Model.ReturnUrl,
        embedded = Model.IsEmbedded,
        selectedEducationId = Model.EducationId > 0 ? Model.EducationId : null,
        selectedInstituteId = Model.InstituteOrSchoolId > 0 ? Model.InstituteOrSchoolId : null
    }) ?? string.Empty;
    var cancelUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Url.Action("Create", "Cv", new { section = "opleidingen" })
        : Model.ReturnUrl;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-mortarboard text-primary fs-4"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1 fs-4">Nieuwe opleiding</h2>
                <p class="text-muted mb-0 small">Voeg een nieuwe opleiding toe aan je CV.</p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-plus text-primary"></i>
                    <span class="fw-semibold">Opleidingsgegevens</span>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center js-cv-success-alert" data-auto-hide-ms="5000" role="alert" aria-live="polite">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@successMessage</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert" aria-live="polite">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@errorMessage</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data" class="js-cv-create-form">

                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="IsEmbedded" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="StartYear" class="form-label fw-medium">Startjaar</label>
                                <input asp-for="StartYear" class="form-control" placeholder="bijv. 2018"/>
                                <div class="form-text text-muted">Het jaar waarin je bent gestart.</div>
                                <span asp-validation-for="StartYear" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndYear" class="form-label fw-medium">Eindjaar</label>
                                <input asp-for="EndYear" class="form-control" placeholder="bijv. 2022"/>
                                <div class="form-text text-muted">Afstudeer jaar .</div>
                                <span asp-validation-for="EndYear" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <partial name="_LookupCard"
                                 model='new CVAPP.UI.Web.MVC.Models.CvEducationLookupCardViewModel
                                 {
                                     FieldName = nameof(Model.EducationId),
                                     Label = "Opleiding",
                                     Kind = "education",
                                     BadgeText = "LOOKUP",
                                     Placeholder = "Kies een opleiding",
                                     SelectedName = Model.SelectedEducationName,
                                     HelperText = "Koppel dit CV-item aan een bestaande opleiding of registreer een nieuwe opleiding.",
                                     CreateController = "Education",
                                     CreateReturnUrl = nestedReturnUrl,
                                     IsEmbedded = Model.IsEmbedded,
                                     CreateTitle = "Nieuwe opleiding toevoegen",
                                     Value = Model.EducationId
                                 }' />

                        <partial name="_LookupCard"
                                 model='new CVAPP.UI.Web.MVC.Models.CvEducationLookupCardViewModel
                                 {
                                     FieldName = nameof(Model.InstituteOrSchoolId),
                                     Label = "Instituut / School",
                                     Kind = "institute",
                                     BadgeText = "LOOKUP",
                                     Placeholder = "Kies een instituut of school",
                                     SelectedName = Model.SelectedInstituteOrSchoolName,
                                     HelperText = "Koppel dit CV-item aan een bestaand instituut of registreer een nieuwe school.",
                                     CreateController = "Institute",
                                     CreateReturnUrl = nestedReturnUrl,
                                     IsEmbedded = Model.IsEmbedded,
                                     CreateTitle = "Nieuw instituut toevoegen",
                                     Value = Model.InstituteOrSchoolId
                                 }' />

                        <div class="row g-3 mb-4">
                            <div class="col-md-7">
                                <label asp-for="Diploma" class="form-label fw-medium">Diploma / Titel</label>
                                <input asp-for="Diploma" type="file" class="form-control"/>
                                <span asp-validation-for="Diploma" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Status" class="form-label fw-medium">Status</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<EducationStatus>()" class="form-select">
                                    <option value="">-- Selecteer status --</option>
                                </select>
                                <span asp-validation-for="Status" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill">
                                <i class="bi bi-check2-circle"></i> Opslaan
                            </button>
                            <a href="@cancelUrl"
                               class="btn btn-outline-secondary btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill js-embedded-cancel">
                                <i class="bi bi-x-lg"></i> Annuleren
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="application/json" data-lookup-source="education">@Html.Raw(JsonSerializer.Serialize(Model.EducationLookupRows))</script>
<script type="application/json" data-lookup-source="institute">@Html.Raw(JsonSerializer.Serialize(Model.InstituteLookupRows))</script>
<partial name="_LookupBrowserModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
