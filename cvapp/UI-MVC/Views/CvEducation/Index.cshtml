@model IEnumerable<cvapp.BL.Domain.CvEducation>

@{
    ViewData["Title"] = "Opleidingen";
    Layout = "_Layout";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-mortarboard text-primary fs-4"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1 fs-4">Opleidingen</h2>
                <p class="text-muted mb-0 small">Beheer de opleidingsgegevens van dit CV.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-personId="@ViewBag.PersonId" class="btn btn-primary btn-lg rounded-pill p-3 d-inline-flex align-items-center justify-content-center" title="Nieuwe opleiding">
                <i class="bi bi-plus-circle-fill fs-5"></i>
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4 fw-semibold text-muted text-uppercase small">Periode</th>
                        <th class="fw-semibold text-muted text-uppercase small">Opleiding</th>
                        <th class="fw-semibold text-muted text-uppercase small d-none d-lg-table-cell">EducationLevel</th>
                        <th class="fw-semibold text-muted text-uppercase small d-none d-lg-table-cell">EQF</th>
                        <th class="fw-semibold text-muted text-uppercase small d-none d-md-table-cell">Instituut</th>
                        <th class="fw-semibold text-muted text-uppercase small d-none d-lg-table-cell">Diploma</th>
                        <th class="fw-semibold text-muted text-uppercase small">Status</th>
                        <th class="text-end pe-4 fw-semibold text-muted text-uppercase small">Acties</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-bottom border-light">
                            <td class="ps-4 fw-medium">
                                @item.StartYear - @item.EndYear
                            </td>
                            <td class="fw-medium">@item.Major?.Name</td>
                            <td class="text-muted small d-none d-lg-table-cell">
                                @item.Major?.EducationLevel?.EducationLevel
                            </td>
                            <td class="text-muted small d-none d-lg-table-cell">
                                @item.Major?.Eqf
                            </td>
                            <td class="text-muted small d-none d-md-table-cell">@item.InstituteOrSchool?.Name</td>
                            <td class="text-muted small d-none d-lg-table-cell">@item.Diploma</td>
                            <td>
                                @{
                                    string statusText = item.Status.ToString();
                                    string badgeClass = "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25";

                                    if (statusText.Contains("bezig", StringComparison.OrdinalIgnoreCase) ||
                                        statusText.Contains("progress", StringComparison.OrdinalIgnoreCase))
                                    {
                                        badgeClass = "bg-info bg-opacity-10 text-info border border-info border-opacity-25";
                                    }
                                    else if (statusText.Contains("afgerond", StringComparison.OrdinalIgnoreCase) ||
                                             statusText.Contains("completed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        badgeClass = "bg-success bg-opacity-10 text-success border border-success border-opacity-25";
                                    }
                                    else if (statusText.Contains("gestopt", StringComparison.OrdinalIgnoreCase) ||
                                             statusText.Contains("stopped", StringComparison.OrdinalIgnoreCase))
                                    {
                                        badgeClass = "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";
                                    }
                                }
                                <span class="badge @badgeClass rounded-pill px-3 py-2 fw-medium">@statusText</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="DownloadDiploma"
                                       asp-route-id="@item.Id"
                                       asp-route-returnUrl="@Url.Action("Index", "CvEducation")"
                                       class="btn btn-sm btn-light text-primary border"
                                       
                                       title="Diploma downloaden">
                                        <i class="bi bi-download fs-5"></i>
                                    </a>
                                   

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning border" title="Bewerken">
                                        <i class="bi bi-pencil fs-5"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-light text-danger border"
                                            title="Verwijderen"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteCvEducationModal"
                                            data-cveducation-id="@item.Id"
                                            data-cveducation-name="@item.Major?.Name"
                                            data-cveducation-period="@item.StartYear - @item.EndYear">
                                        <i class="bi bi-trash3 fs-5"></i>
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }</tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="card-body text-center py-5">
                <i class="bi bi-mortarboard fs-1 mb-3 d-block opacity-50 text-muted"></i>
                <h5 class="mb-2 fw-semibold">Geen opleidingen toegevoegd</h5>
                <p class="text-muted mb-4 small px-md-5">Voeg je eerste opleiding toe om dit CV compleet te maken.</p>
                <a asp-action="Create" asp-route-personId="@ViewBag.PersonId" class="btn btn-primary btn-lg rounded-pill p-3 d-inline-flex align-items-center justify-content-center" title="Nieuwe opleiding">
                    <i class="bi bi-plus-circle-fill fs-5"></i>
                </a>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="deleteCvEducationModal" tabindex="-1" aria-labelledby="deleteCvEducationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteCvEducationModalLabel">
                    Delete Education
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete this education entry?</p>
                <div class="bg-light rounded-3 px-3 py-2 small text-muted">
                    <div><strong id="deleteCvEducationName"></strong></div>
                    <div id="deleteCvEducationPeriod"></div>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="Delete" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteCvEducationId" name="id" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


