@model CVAPP.UI.Web.MVC.Models.CreateEducationViewModel

@{
    ViewData["Title"] = "Nieuwe opleiding";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";
    var targetFrame = "_self";
}

<div class="container py-4">
    @if (!Model.IsEmbedded)
    {
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-book text-primary fs-4"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1 fs-4">Nieuwe opleiding</h2>
                <p class="text-muted mb-0 small">Voeg een opleiding toe aan je CV-profiel.</p>
            </div>
        </div>
    </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-text text-primary"></i>
                    <span class="fw-semibold">Opleidingsgegevens</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" target="@targetFrame">
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="IsEmbedded" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-medium">Naam opleiding</label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Bijv. Bachelor Informatica"/>
                                <span asp-validation-for="Name" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Eqf" class="form-label fw-medium">EQF-niveau</label>
                                <input asp-for="Eqf" class="form-control form-control-lg" placeholder="Bijv. 6"/>
                                <div class="form-text text-muted">Niveau binnen het European Qualifications Framework.</div>
                                <span asp-validation-for="Eqf" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4 align-items-center">
                            <div class="col-md-8">
                                <label asp-for="EducationLevelId" class="form-label fw-medium">Opleidingsniveau</label>
                                <select asp-for="EducationLevelId" asp-items="Model.EducationLevels" class="form-select form-select-lg">
                                    <option value="">-- Selecteer opleidingsniveau --</option>
                                </select>
                                <span asp-validation-for="EducationLevelId" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mt-md-4">
                                    <input asp-for="IsQualified" class="form-check-input"/>
                                    <label asp-for="IsQualified" class="form-check-label fw-medium">Gekwalificeerd?</label>
                                </div>
                                <span asp-validation-for="IsQualified" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill">
                                <i class="bi bi-check2-circle"></i> Opleiding toevoegen
                            </button>
                            <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Create", "Cv", new { section = "opleidingen" }) : Model.ReturnUrl)"
                               target="@targetFrame"
                               class="btn btn-outline-secondary btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill js-embedded-cancel">
                                <i class="bi bi-x-lg"></i> Annuleren
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
