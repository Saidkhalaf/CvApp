@model IEnumerable<cvapp.BL.Domain.CvCertificate>

@{
    ViewData["Title"] = "Certificaten";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Certificaten</h2>
            <p class="text-muted mb-0">Overzicht van alle certificaten.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Nieuw certificaat
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Jaar</th>
                            <th>Certificaat</th>
                            <th>Code</th>
                            <th>Instituut</th>
                            <th>Vervalt op</th>
                            <th class="text-end">Acties</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var certificate in Model)
                        {
                            <tr>
                                <td>@certificate.Year</td>
                                <td>@certificate.CertificateName?.Name</td>
                                <td>@certificate.CertificateCode</td>
                                <td>@certificate.InstituteOrSchool?.Name</td>
                                <td>@certificate.ExpiresOn.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@certificate.Id" class="btn btn-sm btn-light text-warning border">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-award fs-1 text-muted opacity-50 d-block mb-3"></i>
                    <h5 class="fw-semibold">Geen certificaten gevonden</h5>
                    <p class="text-muted mb-0">Maak je eerste certificaat aan.</p>
                </div>
            }
        </div>
    </div>
</div>
