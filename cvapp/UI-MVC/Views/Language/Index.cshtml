@model System.Collections.Generic.IEnumerable<cvapp.BL.Domain.Language>
@using cvapp.ui.web.mvc.Extensions

@{
    ViewBag.Title = "Talen";
    Layout = "_Layout";
}

<div class="container py-8 language-index">
    
        <div class="border-start border-4 border-primary bg-light rounded-3 shadow-sm p-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 d-flex align-items-center justify-content-center">
                        <i class="bi bi-translate text-primary fs-4"></i>
                    </div>
                    <div>
                                <h2 class="fw-bold mb-1 fs-4">Talen</h2>
                                <p class="text-muted mb-0">Beheer talen en taalniveaus van dit CV.</p>
                    </div>
                </div>

                <a asp-controller="Language" asp-action="Add"
                   class="btn btn-primary btn-lg rounded-pill px-4 shadow d-inline-flex align-items-center gap-2 fw-semibold">
                                    <i class="bi bi-plus-lg"></i> Nieuwe taal
                </a>
            </div>
        </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                <tr>
                    <th class="ps-4 fw-semibold text-muted text-uppercase small">ID</th>
                    <th class="fw-semibold text-muted text-uppercase small">Taal</th>
                    <th class="fw-semibold text-muted text-uppercase small">Niveau</th>
                    <th class="fw-semibold text-muted text-uppercase small">Persoon ID</th>
                    <th class="text-end pe-4 fw-semibold text-muted text-uppercase small">Acties</th>
                </tr>
                </thead>
                <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var lang in Model)
                    {
                        <tr class="border-bottom border-light">
                            <td class="ps-4 text-muted small font-monospace">#@lang.Id</td>
                            <td class="fw-medium">@lang.LanguageName.ToString().Replace("_", " ")</td>
                            <td>
                                @{
                                    string badgeClass = lang.LanguageLevel.ToString().ToLower() switch
                                    {
                                        "beginner" or "basic" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
                                        "intermediate" or "conversational" => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
                                        "advanced" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                                        "native" or "fluent" or "expert" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                                        _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill px-3 py-2 fw-medium">
                                    @lang.LanguageLevel.GetDisplayName()
                                </span>
                            </td>
                            <td class="text-muted small">@lang.PersonId</td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-languageId="@lang.Id" class="btn btn-sm btn-light text-warning border" title="Bewerken">
                                        <i class="bi bi-pencil fs-5"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-languageId="@lang.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light text-danger border" title="Verwijderen">
                                            <i class="bi bi-trash3 fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-translate fs-1 mb-3 d-block opacity-50"></i>
                                <h5 class="mb-2">Nog geen talen toegevoegd</h5>
                                <p class="mb-4 small">Voeg je eerste taal toe om dit CV compleet te maken.</p>
                                <a asp-action="Add" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i> Nieuwe taal
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

