@model cvapp.ui.web.mvc.Models.EditLanguageViewmodel
@using cvapp.BL.Domain.enums

@{
    ViewBag.Title = "Taal bewerken";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";
    var targetFrame = Model.IsEmbedded ? "_top" : "_self";
}

<div class="container py-8">
    <div class="border-start border-4 border-primary bg-light rounded-3 shadow-sm p-4 mb-4">
    
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-pencil-square text-warning fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-1 fs-4">Taal bewerken</h2>
                    <p class="text-muted mb-0 small">Pas taal en niveau aan voor deze invoer.</p>
                </div>
            </div>
            <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Create", "Cv", new { section = "talen" }) : Model.ReturnUrl)"
               target="@targetFrame"
               class="btn btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2 js-embedded-cancel">
                <i class="bi bi-arrow-left"></i> Terug
            </a>
        </div>
        </div>

        <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-gear text-primary"></i>
                    <span class="fw-semibold">Wijzig gegevens</span>
                </div>
                <div class="card-body p-4">
                 

                    <form asp-action="Edit" method="post" target="@targetFrame">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-start gap-2 mb-4 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                            <ul class="mb-0 ps-3"></ul>
                        </div>
                        <input asp-for="Id" type="hidden"/>
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="IsEmbedded" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-medium text-dark">Taal</label>
                            <select asp-for="Name" asp-items="Html.GetEnumSelectList<LanguageName>()" class="form-select form-select-lg">
                                <option value="" disabled>-- Selecteer een taal --</option>
                            </select>
                            <div class="form-text text-muted mt-1">Kies de taal die je wilt instellen.</div>
                            <span asp-validation-for="Name" class="d-block text-danger small mt-1 fw-medium"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LanguageLevel" class="form-label fw-medium text-dark">Niveau</label>
                            <select asp-for="LanguageLevel" asp-items="Html.GetEnumSelectList<LanguageLevel>()" class="form-select form-select-lg">
                                <option value="" disabled>-- Selecteer een niveau --</option>
                            </select>
                            <div class="form-text text-muted mt-1">Pas het taalniveau aan waar nodig.</div>
                            <span asp-validation-for="LanguageLevel" class="d-block text-danger small mt-1 fw-medium"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 d-flex align-items-center justify-content-center gap-2 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle"></i> Wijzigingen opslaan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}