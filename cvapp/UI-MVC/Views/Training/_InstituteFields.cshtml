@using cvapp.BL.Domain.enums
@model CVAPP.UI.Web.MVC.Models.CreateInstituteViewModel

@* Sectie 1: Basisgegevens *@
<h6 class="text-success fw-bold mb-3 border-bottom border-success-subtle pb-2">
    <i class="bi bi-info-square me-2"></i>Basisinformatie Instituut
</h6>

<div class="row g-3 mb-4">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label fw-semibold text-body">Naam instituut/school</label>
        <input asp-for="Name" class="form-control bg-body text-body border-secondary-subtle" placeholder="Bijv. Universiteit Brussel" />
    </div>
    <div class="col-md-4">
        <label asp-for="Type" class="form-label fw-semibold text-body">Type instituut</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<InstituteType>()" class="form-select bg-body text-body border-secondary-subtle">
            <option value="">-- Selecteer type --</option>
        </select>
    </div>
</div>

@* Sectie 2: Contactgegevens *@
<h6 class="text-success fw-bold mb-3 border-bottom border-success-subtle pb-2">
    <i class="bi bi-telephone me-2"></i>Contact & Aanvullend
</h6>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Email" class="form-label fw-semibold text-body">E-mailadres</label>
        <input asp-for="Email" type="email" class="form-control bg-body text-body border-secondary-subtle" placeholder="info@instituut.be" />
    </div>
    <div class="col-md-6">
        <label asp-for="Website" class="form-label fw-semibold text-body">Website</label>
        <input asp-for="Website" type="url" class="form-control bg-body text-body border-secondary-subtle" placeholder="https://www.instituut.be" />
    </div>
    <div class="col-md-6">
        <label asp-for="BtwNumber" class="form-label fw-semibold text-body">BTW-nummer</label>
        <input asp-for="BtwNumber" class="form-control bg-body text-body border-secondary-subtle" />
    </div>
    <div class="col-md-6">
        <label asp-for="TelephoneNumber" class="form-label fw-semibold text-body">Telefoonnummer</label>
        <input asp-for="TelephoneNumber" type="tel" class="form-control bg-body text-body border-secondary-subtle" />
    </div>
    <div class="col-md-6">
        <label asp-for="Fax" class="form-label fw-semibold text-body">Fax</label>
        <input asp-for="Fax" class="form-control bg-body text-body border-secondary-subtle" />
    </div>
    <div class="col-md-6">
        <label asp-for="Comments" class="form-label fw-semibold text-body">Opmerkingen</label>
        <textarea asp-for="Comments" class="form-control bg-body text-body border-secondary-subtle" rows="2"></textarea>
    </div>
</div>