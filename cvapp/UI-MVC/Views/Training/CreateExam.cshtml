@model CVAPP.UI.Web.MVC.Models.Training.CreateExamViewModel

@{
    ViewData["Title"] = "Nieuw examen";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";
    var targetFrame = Model.IsEmbedded ? "_parent" : "_self";
    var backUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Url.Action("Create", "Training", new { embedded = Model.IsEmbedded })
        : Model.ReturnUrl;
    var containerClass = Model.IsEmbedded ? "p-3" : "container py-4";
    var cardWrapperClass = Model.IsEmbedded ? "" : "row justify-content-center";
    var cardColumnClass = Model.IsEmbedded ? "" : "col-lg-8 col-xl-6";
    var backButtonClass = Model.IsEmbedded ? "btn btn-outline-secondary btn-sm js-embedded-cancel" : "btn btn-outline-secondary";
    var saveButtonClass = Model.IsEmbedded ? "btn btn-primary btn-sm" : "btn btn-primary";
    var actionsClass = Model.IsEmbedded ? "d-flex justify-content-end gap-2" : "d-flex justify-content-between";
}

<div class="@containerClass">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-patch-check text-primary fs-4"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1 fs-4">Nieuw examen</h2>
                <p class="text-muted mb-0 small">Voeg een nieuw examen voor je training/cursus.</p>
            </div>
        </div>
    </div>
    
    <div class="@cardWrapperClass">
        <div class="@cardColumnClass">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-controller="Training" asp-action="CreateExam" method="post" novalidate target="@targetFrame">
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden"/>
                        <input asp-for="IsEmbedded" type="hidden"/>
                        <input asp-for="SelectedInstituteId" type="hidden"/>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Naam examen *</label>
                            <input asp-for="Name" class="form-control" placeholder="Bijv. Final Exam"/>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Result" class="form-label fw-semibold">Resultaat *</label>
                            <select asp-for="Result" class="form-select">
                                <option value="">-- Selecteer resultaat --</option>
                                <option value="1">Niet van toepassing</option>
                                <option value="2">Geslaagd</option>
                                <option value="3">In behandeling</option>
                                <option value="4">Gecertificeerd</option>
                                <option value="5">Niet geslaagd</option>
                            </select>
                            <span asp-validation-for="Result" class="text-danger small"></span>
                        </div>

                        <div class="@actionsClass">
                            <a href="@backUrl" target="@targetFrame" class="@backButtonClass">Terug</a>
                            <button type="submit" class="@saveButtonClass">Examen opslaan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}