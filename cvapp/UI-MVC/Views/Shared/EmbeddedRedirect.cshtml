@model string
@{
    Layout = null;
    var targetUrl = string.IsNullOrWhiteSpace(Model) ? "/" : Model;
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doorsturen...</title>
</head>
<body>
<script>
    window.top.location.assign(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(targetUrl)));
</script>
<noscript>
    <p>Doorsturen...</p>
    <p><a href="@targetUrl" target="_top">Ga verder</a></p>
</noscript>
</body>
</html>
