@model cvapp.ui.web.mvc.Models.Cv.PersonalInfoViewModel

@{
    var successMessage = ViewData["SuccessMessage"] as string;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var showMessageInSection = ViewData["ShowMessageInSection"] as Func<string, bool>;
    var certificatenReturnUrl = ViewData["CertificatenReturnUrl"] as string ?? string.Empty;
    var showSuccess = !string.IsNullOrWhiteSpace(successMessage) && (showMessageInSection?.Invoke("certificaten") ?? false);
    var showError = !string.IsNullOrWhiteSpace(errorMessage) && (showMessageInSection?.Invoke("certificaten") ?? false);
}

<section id="certificaten" class="mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-body border-0 pt-4 px-4 px-lg-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-award text-primary fs-2 me-3"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Certificaten</h3>
                        <p class="text-muted mb-0">Beheer de certificaten van dit CV.</p>
                    </div>
                </div>

                <button type="button"
                        class="btn p-0 text-decoration-none"
                        data-bs-toggle="modal"
                        data-bs-target="#addCvCertificateModal"
                        title="Nieuw certificaat toevoegen">
                    <i class="bi bi-plus-circle fs-1"></i>
                </button>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            @if (showSuccess)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center js-cv-success-alert"
                     data-auto-hide-ms="5000"
                     role="alert"
                     aria-live="polite">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>@successMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            }

            @if (showError)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center js-cv-success-alert"
                     data-auto-hide-ms="3000"
                     role="alert"
                     aria-live="polite">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@errorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            }

            @if (Model.CvCertificates.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-body-tertiary border-bottom">
                        <tr>
                            <th class="fw-semibold text-muted text-uppercase small">Jaar</th>
                            <th class="fw-semibold text-muted text-uppercase small">Certificaat</th>
                            <th class="fw-semibold text-muted text-uppercase small d-none d-md-table-cell">Code</th>
                            <th class="fw-semibold text-muted text-uppercase small d-none d-lg-table-cell">Instituut</th>
                            <th class="fw-semibold text-muted text-uppercase small d-none d-lg-table-cell">Vervalt op</th>
                            <th class="text-end fw-semibold text-muted text-uppercase small">Acties</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var certificate in Model.CvCertificates)
                        {
                            var hasCertificateFile = !string.IsNullOrWhiteSpace(certificate.Certificate);

                            <tr class="border-bottom border-secondary-subtle">
                                <td class="fw-medium">@certificate.Year</td>
                                <td class="fw-medium">@certificate.CertificateName?.Name</td>
                                <td class="text-muted small d-none d-md-table-cell">@certificate.CertificateCode</td>
                                <td class="text-muted small d-none d-lg-table-cell">@certificate.InstituteOrSchool?.Name</td>
                                <td class="text-muted small d-none d-lg-table-cell">@certificate.ExpiresOn.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="CvCertificate"
                                           asp-action="DownloadCertificate"
                                           asp-route-id="@certificate.Id"
                                           asp-route-returnUrl="@certificatenReturnUrl"
                                           class="btn btn-sm btn-light border @(hasCertificateFile ? "text-success" : "text-danger")"
                                           title="@(hasCertificateFile ? "Certificaat downloaden" : "Geen certificaat beschikbaar")">
                                            <i class="bi bi-download"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-light text-warning border"
                                                title="Bewerken"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCvCertificateModal"
                                                data-modal-title="Certificaat bewerken"
                                                data-modal-src="@(Url.Action("Edit", "CvCertificate", new { id = certificate.Id, returnUrl = certificatenReturnUrl, embedded = true }) ?? string.Empty)">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-light text-danger border"
                                                title="Verwijderen"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteCvItemModal"
                                                data-delete-action="@(Url.Action("Delete", "CvCertificate") ?? "/CvCertificate/Delete")"
                                                data-delete-id="@certificate.Id"
                                                data-delete-id-name="id"
                                                data-delete-return-url="@certificatenReturnUrl"
                                                data-delete-label="@(certificate.CertificateName?.Name ?? "dit certificaat")"
                                                data-delete-type="certificaat">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-body-tertiary rounded-4">
                    <i class="bi bi-award fs-1 text-muted opacity-50 d-block mb-3"></i>
                    <h5 class="mb-2 fw-semibold">Geen certificaten toegevoegd</h5>
                    <p class="text-muted mb-4">Voeg je eerste certificaat toe om dit CV compleet te maken.</p>

                    <button type="button"
                            class="btn btn-primary rounded-pill px-4 d-inline-flex align-items-center gap-2"
                            data-bs-toggle="modal"
                            data-bs-target="#addCvCertificateModal">
                        <i class="bi bi-plus-lg"></i>
                        Nieuw certificaat
                    </button>
                </div>
            }
        </div>
    </div>
</section>
