@using cvapp.ui.web.mvc.Extensions
@model cvapp.ui.web.mvc.Models.Cv.PersonalInfoViewModel
@{
    var successMessage = ViewData["SuccessMessage"] as string;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var showMessageInSection = ViewData["ShowMessageInSection"] as Func<string, bool>;
    var talenReturnUrl = ViewData["TalenReturnUrl"] as string ?? string.Empty;
    var showSuccess = !string.IsNullOrWhiteSpace(successMessage) && (showMessageInSection?.Invoke("talen") ?? false);
    var showError = !string.IsNullOrWhiteSpace(errorMessage) && (showMessageInSection?.Invoke("talen") ?? false);
    var addLanguageModalSrc = Url.Action("Add", "Language", new { returnUrl = talenReturnUrl, embedded = true });
}

<section id="talen" class="mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-body border-0 pt-4 px-4 px-lg-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-grip-vertical fs-3 me-2 cursor-move js-drag-handle" aria-label="Versleep sectie"></i>
                    <i class="bi bi-translate text-primary fs-2 me-3"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Talen</h3>
                        <p class="text-muted mb-0">Beheer talen en niveaus voor dit CV.</p>
                    </div>
                </div>
                
                <button type="button"
                        class="btn p-0 text-decoration-none"
                        data-bs-toggle="modal"
                        data-bs-target="#addLanguageModal"
                        title="Nieuwe Taal toevoegen">

                    <i class="bi bi-plus-circle fs-1"  ></i>
                </button>
            </div>
        </div>
        <div class="card-body p-4 p-lg-5">
            @if (showSuccess)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center js-cv-success-alert" data-auto-hide-ms="5000" role="alert" aria-live="polite">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>@successMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            }
            @if (showError)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert" aria-live="polite">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@errorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            }

            @if (Model.Languages.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-body-tertiary border-bottom">
                        <tr>
                            <th class="fw-semibold text-muted text-uppercase small">ID</th>
                            <th class="fw-semibold text-muted text-uppercase small">Taal</th>
                            <th class="fw-semibold text-muted text-uppercase small">Niveau</th>
                            <th class="text-end fw-semibold text-muted text-uppercase small">Acties</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var language in Model.Languages)
                        {
                            <tr class="border-bottom border-secondary-subtle">
                                <td class="text-muted small font-monospace">#@language.Id</td>
                                <td class="fw-medium">@language.LanguageName</td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-2 fw-medium">@language.LanguageLevel.GetDisplayName()</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-light text-warning border" title="Bewerken" data-bs-toggle="modal" data-bs-target="#editLanguageModal" data-modal-title="Taal bewerken" data-modal-src="@(Url.Action("Edit", "Language", new { languageId = language.Id, returnUrl = talenReturnUrl, embedded = true }) ?? string.Empty)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light text-danger border" data-bs-toggle="modal" data-bs-target="#deleteCvItemModal" data-delete-action="@(Url.Action("Delete", "Language") ?? "/Language/Delete")" data-delete-id="@language.Id" data-delete-id-name="languageId" data-delete-return-url="@talenReturnUrl" data-delete-label="@language.LanguageName" data-delete-type="taal">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-body-tertiary rounded-4">
                    <i class="bi bi-translate fs-1 text-muted opacity-50 d-block mb-3"></i>
                    <h5 class="mb-2 fw-semibold">Geen talen toegevoegd</h5>
                    <p class="text-muted mb-4">Voeg je eerste taal toe om je profiel compleet te maken.</p>
                    <button type="button" class="btn btn-outline-primary rounded-pill px-4 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addLanguageModal">
                        <i class="bi bi-plus-lg"></i>
                        Nieuwe taal
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade cv-modal-blur" id="addLanguageModal" tabindex="-1" aria-labelledby="addLanguageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addLanguageModalLabel">Nieuwe taal toevoegen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body p-0">
                <iframe title="CV-taal toevoegen" class="w-100 cv-embed-frame" src="@addLanguageModalSrc"></iframe>
            </div>
        </div>
    </div>
</div>

<div class="modal fade cv-modal-blur" id="editLanguageModal" tabindex="-1" aria-labelledby="editLanguageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editLanguageModalLabel">Taal bewerken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body p-0">
                <iframe title="CV-taal bewerken" class="w-100 cv-embed-frame" src="about:blank"></iframe>
            </div>
        </div>
    </div>
</div>
