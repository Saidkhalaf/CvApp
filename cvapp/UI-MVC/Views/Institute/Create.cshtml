@model CVAPP.UI.Web.MVC.Models.CreateInstituteViewModel

@{
    ViewData["Title"] = "Nieuw instituut/school";
    Layout = Model.IsEmbedded ? "_EmbeddedLayout" : "_Layout";
    // In embedded mode, return to the parent iframe (training form), not the top page.
    var targetFrame = Model.IsEmbedded ? "_parent" : "_self";
    var isEmbedded = Model.IsEmbedded;
    var containerClass = isEmbedded ? "container py-2 px-2" : "container py-4 min-vh-100 d-flex flex-column";
    var rowClass = isEmbedded ? "row justify-content-center" : "row justify-content-center flex-grow-1";
}

<div class="@containerClass">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-success bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-building text-success fs-4"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1 fs-4">Nieuw instituut/school</h2>
                <p class="text-muted mb-0 small">Voeg een onderwijsinstelling toe aan je CV-profiel.</p>
            </div>
        </div>
    </div>

    <div class="@rowClass">
        <div class="col-lg-12 d-flex">
            <div class="card border-0 shadow rounded-4 overflow-hidden w-100">
                <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-building-gear text-primary"></i>
                    <span class="fw-semibold">Gegevens instituut/school</span>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <form asp-action="Create" method="post" target="@targetFrame" class="d-flex flex-column flex-grow-1">
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden"/>
                        <input asp-for="IsEmbedded" type="hidden"/>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <h5 class="fw-semibold mb-3 pb-2 border-bottom text-dark">Basisinformatie</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-medium">Naam instituut/school</label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Bijv. Universiteit Brussel"/>
                                <span asp-validation-for="Name" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Type" class="form-label fw-medium">Type instituut</label>
                                <select asp-for="Type" asp-items="Model.InstituteTypes" class="form-select form-select-lg">
                                    <option value="">-- Selecteer type --</option>
                                </select>
                                <span asp-validation-for="Type" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <h5 class="fw-semibold mb-3 pb-2 border-bottom text-dark">Contactgegevens</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium">E-mailadres</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="contact@institute.edu"/>
                                <span asp-validation-for="Email" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label fw-medium">Website</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-link-45deg text-muted"></i></span>
                                    <input asp-for="Website" type="url" class="form-control" placeholder="https://www.institute.edu"/>
                                </div>
                                <span asp-validation-for="Website" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TelephoneNumber" class="form-label fw-medium">Telefoonnummer</label>
                                <input asp-for="TelephoneNumber" type="tel" class="form-control" placeholder="+32 2 123 45 67"/>
                                <span asp-validation-for="TelephoneNumber" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Fax" class="form-label fw-medium">Fax (optioneel)</label>
                                <input asp-for="Fax" type="tel" class="form-control" placeholder="+32 2 123 45 68"/>
                                <span asp-validation-for="Fax" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <h5 class="fw-semibold mb-3 pb-2 border-bottom text-dark">Aanvullende gegevens</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="BtwNumber" class="form-label fw-medium">BTW-nummer</label>
                                <input asp-for="BtwNumber" class="form-control" placeholder="BE 0123.456.789"/>
                                <div class="form-text text-muted">Belgisch btw-identificatienummer (indien van toepassing).</div>
                                <span asp-validation-for="BtwNumber" class="d-block text-danger small mt-1"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Comments" class="form-label fw-medium">Opmerkingen</label>
                                <textarea asp-for="Comments" class="form-control" rows="3" placeholder="Eventuele aanvullende informatie over dit instituut..."></textarea>
                                <span asp-validation-for="Comments" class="d-block text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-3 border-top">
                            <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill">
                                <i class="bi bi-check2-circle"></i> Instituut/school toevoegen
                            </button>
                            @{
                                string cancelUrl;

                                if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                                {
                                    // Use the return URL provided by the previous page
                                    cancelUrl = Model.ReturnUrl;
                                }
                                else
                                {
                                    if (ViewContext.RouteData.Values["controller"]?.ToString() == "Training" || 
                                        (Model.ReturnUrl != null && Model.ReturnUrl.Contains("Training", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        cancelUrl = Url.Action("Create", "Cv", new { section = "cursussen-trainingen" });
                                    }
                                    else
                                    {
                                        cancelUrl = Url.Action("Create", "Cv", new { section = "opleidingen" });
                                    }
                                }
                            }
                            <a href="@cancelUrl"
                               target="@targetFrame"
                               class="btn btn-outline-secondary flex-grow-1 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-pill js-embedded-cancel">
                                <i class="bi bi-x-lg"></i> Annuleren
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
